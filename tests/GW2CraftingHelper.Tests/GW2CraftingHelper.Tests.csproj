<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\StyleGate.props" />

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- xUnit1031 is a deadlock rule, not a style rule. Blocking inside a
         synchronous [Fact] parks a worker on xUnit's MaxConcurrencySyncContext:
         enough simultaneous blocks stall the run, which presents as a hung job
         with no failing test - the worst thing to be handed. xunit.runner.json
         now pins maxParallelThreads to 4, so the ceiling is the same on a
         2-core CI box and a 16-core desktop instead of tracking whatever the
         machine reports. xUnit2009 is here because the twelve warnings these
         two codes produced had gone unread for long enough to prove nobody was
         reading test-project warnings at all. -->
    <WarningsAsErrors>xUnit1031;xUnit2009</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Goldens\**\*" CopyToOutputDirectory="PreserveNewest" />

    <!--
      The SHIPPED glyph font, not a copy of it: GlyphFontDescriptorTests reads
      the same two files the .bhm packages, through the same parser the module
      loads them with. A fixture copy would have let the atlas and the code
      drift apart, which is the one failure a glyph font cannot show on screen.
      Linked rather than copied into the test tree for the same reason.
    -->
    <None Include="..\..\ref\glyphs.fnt" Link="ref\glyphs.fnt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\ref\glyphs_0.png" Link="ref\glyphs_0.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <PackageReference Include="System.Text.Json" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GW2CraftingHelper.csproj">
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
  </ItemGroup>


</Project>
