* text=auto

# ref/*.json is generated by the offline seeders under tools/ and is up to
# ~15MB on a single line. -text keeps git from line-ending-normalising an
# opaque blob, -diff stops `git diff`/`git show`/GitHub from rendering it,
# and -merge turns a conflict into a loud failure instead of a silent mangle.
ref/*.json -text -diff -merge linguist-generated=true
