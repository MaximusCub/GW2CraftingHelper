* text=auto

# ref/ holds the offline seeders' output - up to ~15MB of minified JSON on a
# single line. -text keeps git from line-ending-normalising an opaque blob,
# -diff stops `git diff` / `git show` / GitHub from rendering one into a
# terminal, a PR view, or an agent's context window, and -merge turns a
# conflict into a loud failure instead of a silent mangle. Declared as a glob
# so a new seeder output is covered before anyone remembers to add it here.
ref/*.json -text -diff -merge linguist-generated=true

# ...except the files under ref/ a human writes and a reviewer has to read:
# the provenance manifests, the hand-curated vendor exclusions (each row
# carries its own evidence), and the hand-maintained hint/cooldown/sheet
# lists. These are small, and making them unreadable would defeat the point.
ref/*_manifest.json text=auto diff merge -linguist-generated
ref/vendor_offer_exclusions.json text=auto diff merge -linguist-generated
ref/acquisition_hints_seed.json text=auto diff merge -linguist-generated
ref/daily_cooldown_items.json text=auto diff merge -linguist-generated
ref/recipe_sheet_items.json text=auto diff merge -linguist-generated
