<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <!-- Pinned to the value this net48 project actually resolves to today - measured
         via a diagnostic-verbosity build - matching GW2CraftingHelper.csproj (M38
         WP-02 / a6-csharp.md section 10). -->
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GW2CraftingHelper.RecipeSeeder.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\GW2CraftingHelper.csproj">
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\ref\mystic_forge_recipes.json" Link="ref\mystic_forge_recipes.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
