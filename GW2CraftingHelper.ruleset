<?xml version="1.0" encoding="utf-8"?>
<RuleSet Name="GW2CraftingHelper style rules" Description="Custom StyleCop.Analyzers severity overrides. Suppresses only the rules that actively fight this codebase's documented, deliberate house style (CONTRIBUTING.md, Code Style); everything else stays at StyleCop's default (warning) severity so drift gets caught for free. See M38 WP-02." ToolsVersion="16.0">
  <Rules AnalyzerId="StyleCop.Analyzers" RuleNamespace="StyleCop.Analyzers">
    <!-- Doc-mandate rules. An earlier version of this comment claimed the codebase
         documents via prose "//" at decision points rather than <summary> on members.
         Measured, that is false in the direction that matters: 200 of the 248
         production .cs files carry at least one <summary>, 1,247 blocks across 12,118
         "///" lines (2026-08-25). The actual rule is that XML doc is used where it
         earns its place and is not mandated, so SA1600 on the remainder would only
         produce boilerplate restating member names. The live statement of that rule
         is CONTRIBUTING.md, Code Style; this file cites it rather than defining it.

         Measured again, about this entry's own reach: with all three rules below
         flipped to Warning and a forced rebuild of this exact codebase, SA1600 and
         SA1602 emit ZERO diagnostics. The project sets no DocumentationFile, so
         Roslyn leaves XML comment analysis switched off for the whole compilation,
         which is precisely what SA0001 reports (once, project-wide). SA0001 is
         therefore the only one of the three suppressing anything today; SA1600 and
         SA1602 record the decision for the day a DocumentationFile is added. -->
    <Rule Id="SA1600" Action="None" /> <!-- ElementsMustBeDocumented -->
    <Rule Id="SA1602" Action="None" /> <!-- EnumerationItemsMustBeDocumented -->
    <Rule Id="SA0001" Action="None" /> <!-- XmlCommentAnalysisDisabled -->

    <!-- File-header rules assume a license banner on every file. This repo has never
         used one; there is nothing to enforce here. -->
    <Rule Id="SA1633" Action="None" /> <!-- FileMustHaveHeader -->
    <Rule Id="SA1634" Action="None" /> <!-- FileHeaderMustShowCopyright -->
    <Rule Id="SA1635" Action="None" /> <!-- FileHeaderMustHaveCopyrightText -->
    <Rule Id="SA1636" Action="None" /> <!-- FileHeaderCopyrightTextMustMatch -->
    <Rule Id="SA1637" Action="None" /> <!-- FileHeaderMustContainFileName -->
    <Rule Id="SA1638" Action="None" /> <!-- FileHeaderFileNameDocumentationMustMatch -->
    <Rule Id="SA1639" Action="None" /> <!-- FileHeaderMustHaveSummary -->
    <Rule Id="SA1640" Action="None" /> <!-- FileHeaderMustHaveValidCompanyText -->
    <Rule Id="SA1641" Action="None" /> <!-- FileHeaderCompanyNameTextMustMatch -->

    <!-- Fields are private-field-camelCase-with-underscore-prefix (_camelCase) 100%
         consistently across the whole repo (verified: a6-csharp.md section 9, and the
         .editorconfig naming convention added alongside this ruleset codifies exactly
         that). SA1309 demands the opposite (no leading underscore) on every one of
         those same fields - leaving it on would contradict the naming convention this
         same change encodes, not "catch drift" against it. -->
    <Rule Id="SA1309" Action="None" /> <!-- FieldNamesMustNotBeginWithUnderscore -->

    <!-- SA1101 ("prefix local calls with this") and SA1200 ("using directive
         must appear within a namespace") were left at default severity when
         this ruleset first landed, on the assumption they were "already 100%
         followed" (a6-csharp.md section 9) and would therefore only catch
         future drift. A forced-recompile diagnostic build of this exact
         codebase measured that assumption false: SA1101 fires 1467 times
         across 46 of 118 compiled files (no call site anywhere in the
         codebase uses this-qualification) and SA1200 fires 364 times across
         93 of 118 files, 79% (usings are always placed outside the
         namespace, the opposite of what the rule wants). Together the two
         are 61% (1831/2978) of every warning this ruleset produced on a
         clean build of pre-existing code - loud enough to bury the 39% that
         is real, actionable drift, which defeats this file's own stated
         purpose. Suppressed for the same reason as SA1309 above: they
         contradict the codebase's actual, near-universal convention rather
         than catching drift against it. See docs/KNOWN-ISSUES.md #32 for the
         measurement and the smaller-scale rules (SA1413/SA1516/SA1503) that
         remain enabled as tracked cleanup-wave candidates. -->
    <Rule Id="SA1101" Action="None" /> <!-- PrefixLocalCallsWithThis -->
    <Rule Id="SA1200" Action="None" /> <!-- UsingDirectivesMustBePlacedCorrectly -->
  </Rules>
  <Rules AnalyzerId="Microsoft.CodeAnalysis.CSharp.NetAnalyzers" RuleNamespace="Microsoft.CodeAnalysis.CSharp.NetAnalyzers">
    <!-- Not currently produced (no NetAnalyzers package is referenced by this project),
         but disabled defensively so a future generic-analyzer addition can't "fix" this:
         Blish HUD's XNA host installs no SynchronizationContext (see
         Views/MainThreadMarshal.cs's doc comment), so SynchronizationContext.Current is
         already null on every await in this process - ConfigureAwait(false) would skip
         a capture that never happens, adding visual noise for zero behavioral benefit. -->
    <Rule Id="CA2007" Action="None" /> <!-- DoNotDirectlyAwaitATask (ConfigureAwait) -->
  </Rules>
</RuleSet>
